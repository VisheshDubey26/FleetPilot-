<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_fleetpilot_vehicle_tree" model="ir.ui.view">
        <name>fleetpilot.vehicle.tree</name>
        <model>fleetpilot.vehicle</model>
        <arch type="xml">
            <tree string="Vehicles">
                <field name="name"/>
                <field name="license_plate"/>
                <field name="vehicle_type"/>
                <field name="driver_id"/>
                <field name="status" widget="badge" decoration-success="status == 'available'" decoration-warning="status == 'in_trip'" decoration-info="status == 'maintenance'"/>
                <field name="fuel_level" widget="progressbar"/>
                <field name="odometer"/>
            </tree>
        </arch>
    </record>

    <!-- Form View -->
    <record id="view_fleetpilot_vehicle_form" model="ir.ui.view">
        <name>fleetpilot.vehicle.form</name>
        <model>fleetpilot.vehicle</model>
        <arch type="xml">
            <form string="Vehicle">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="available,in_trip,maintenance"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Vehicle Name e.g. Cargo Truck A"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Basic Information">
                            <field name="license_plate"/>
                            <field name="vehicle_type"/>
                            <field name="driver_id"/>
                            <field name="acquisition_date"/>
                        </group>
                        <group string="Telemetry &amp; Status">
                            <field name="fuel_level"/>
                            <field name="odometer"/>
                            <field name="next_maintenance_date"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Trips" name="trips">
                            <field name="trip_ids" readonly="1"/>
                        </page>
                        <page string="Maintenance Logs" name="maintenance">
                            <field name="maintenance_ids" readonly="1"/>
                        </page>
                        <page string="Fuel Logs" name="fuel_logs">
                            <field name="fuel_log_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </arch>
    </record>

    <!-- Search View -->
    <record id="view_fleetpilot_vehicle_search" model="ir.ui.view">
        <name>fleetpilot.vehicle.search</name>
        <model>fleetpilot.vehicle</model>
        <arch type="xml">
            <search string="Search Vehicles">
                <field name="name"/>
                <field name="license_plate"/>
                <filter name="available" string="Available" domain="[('status', '=', 'available')]"/>
                <filter name="in_trip" string="In Trip" domain="[('status', '=', 'in_trip')]"/>
                <filter name="maintenance" string="Under Maintenance" domain="[('status', '=', 'maintenance')]"/>
                <group expand="0" string="Group By">
                    <filter string="Type" name="group_by_type" context="{'group_by': 'vehicle_type'}"/>
                    <filter string="Status" name="group_by_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </arch>
    </record>

    <!-- Action -->
    <record id="action_fleetpilot_vehicle" model="ir.actions.act_window">
        <name>Vehicles</name>
        <res_model>fleetpilot.vehicle</res_model>
        <view_mode>tree,form</view_mode>
        <search_view_id ref="view_fleetpilot_vehicle_search"/>
        <help type="html">
            <p class="o_view_nocontent_smiling_face">
                Register your first vehicle in FleetPilot!
            </p>
        </help>
    </record>

    <!-- Menuitem -->
    <menuitem id="menu_fleetpilot_vehicle"
              name="Vehicles"
              parent="menu_fleetpilot_operations"
              action="action_fleetpilot_vehicle"
              sequence="10"/>
</odoo>
