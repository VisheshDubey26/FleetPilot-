<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_fleetpilot_driver_tree" model="ir.ui.view">
        <name>fleetpilot.driver.tree</name>
        <model>fleetpilot.driver</model>
        <arch type="xml">
            <tree string="Drivers">
                <field name="name"/>
                <field name="license_number"/>
                <field name="license_expiry"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="status" widget="badge" decoration-success="status == 'available'" decoration-warning="status == 'on_trip'" decoration-danger="status == 'suspended'"/>
            </tree>
        </arch>
    </record>

    <!-- Form View -->
    <record id="view_fleetpilot_driver_form" model="ir.ui.view">
        <name>fleetpilot.driver.form</name>
        <model>fleetpilot.driver</model>
        <arch type="xml">
            <form string="Driver">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="available,on_trip,suspended,on_leave"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Driver Full Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="License Info">
                            <field name="license_number"/>
                            <field name="license_expiry"/>
                        </group>
                        <group string="Contact Info">
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Assigned Vehicles" name="vehicles">
                            <field name="vehicle_ids" readonly="1"/>
                        </page>
                        <page string="Trip History" name="trips">
                            <field name="trip_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </arch>
    </record>

    <!-- Search View -->
    <record id="view_fleetpilot_driver_search" model="ir.ui.view">
        <name>fleetpilot.driver.search</name>
        <model>fleetpilot.driver</model>
        <arch type="xml">
            <search string="Search Drivers">
                <field name="name"/>
                <field name="license_number"/>
                <filter name="available" string="Available" domain="[('status', '=', 'available')]"/>
                <filter name="on_trip" string="On Trip" domain="[('status', '=', 'on_trip')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_by_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </arch>
    </record>

    <!-- Action -->
    <record id="action_fleetpilot_driver" model="ir.actions.act_window">
        <name>Drivers</name>
        <res_model>fleetpilot.driver</res_model>
        <view_mode>tree,form</view_mode>
        <search_view_id ref="view_fleetpilot_driver_search"/>
    </record>

    <!-- Menuitem -->
    <menuitem id="menu_fleetpilot_driver"
              name="Drivers"
              parent="menu_fleetpilot_operations"
              action="action_fleetpilot_driver"
              sequence="20"/>
</odoo>
